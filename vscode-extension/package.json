{
  "name": "portpilot",
  "displayName": "PortPilot",
  "description": "See every dev server and port from the sidebar, with crash alerts and the servers your AI assistant started marked.",
  "version": "4.0.6",
  "publisher": "macdara",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/m4cd4r4/PortPilot.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portpilot",
          "title": "PortPilot",
          "icon": "media/portpilot-icon.svg"
        }
      ]
    },
    "views": {
      "portpilot": [
        {
          "id": "portpilot.apps",
          "name": "Apps"
        },
        {
          "id": "portpilot.browsers",
          "name": "Browsers"
        },
        {
          "id": "portpilot.activePorts",
          "name": "Active Ports"
        },
        {
          "id": "portpilot.history",
          "name": "History"
        }
      ]
    },
    "commands": [
      {
        "command": "portpilot.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.startApp",
        "title": "Start App",
        "icon": "$(play)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.stopApp",
        "title": "Stop App",
        "icon": "$(debug-stop)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.killPort",
        "title": "Kill Port",
        "icon": "$(close)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(globe)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.openFolder",
        "title": "Open Folder",
        "icon": "$(folder-opened)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.scanPorts",
        "title": "Scan Ports",
        "icon": "$(search)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.addApp",
        "title": "Add App",
        "icon": "$(add)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.editApp",
        "title": "Edit App",
        "icon": "$(edit)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.deleteApp",
        "title": "Delete App",
        "icon": "$(trash)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.toggleFavorite",
        "title": "Toggle Favorite",
        "icon": "$(star)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.changePort",
        "title": "Change Port",
        "icon": "$(symbol-number)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.deleteAllApps",
        "title": "Delete All Apps",
        "icon": "$(clear-all)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.startWebPortal",
        "title": "Start Web Portal",
        "icon": "$(broadcast)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.stopWebPortal",
        "title": "Stop Web Portal",
        "icon": "$(debug-stop)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.openWebPortal",
        "title": "Open Web Portal in Browser",
        "icon": "$(globe)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.foldStopped",
        "title": "Fold Stopped Apps",
        "icon": "$(fold)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.unfoldStopped",
        "title": "Show Stopped Apps Inline",
        "icon": "$(unfold)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.openHistoryRun",
        "title": "Open Page",
        "icon": "$(globe)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.startHistoryRun",
        "title": "Start Again",
        "icon": "$(play)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.copyHistoryUrl",
        "title": "Copy URL",
        "icon": "$(copy)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.pinHistoryRun",
        "title": "Pin Run",
        "icon": "$(pin)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.unpinHistoryRun",
        "title": "Unpin Run",
        "icon": "$(pinned)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.openHistoryFolder",
        "title": "Open Folder",
        "icon": "$(folder-opened)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.searchHistory",
        "title": "Search History",
        "icon": "$(search)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.refreshHistory",
        "title": "Refresh History",
        "icon": "$(refresh)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.startBrowser",
        "title": "Start Browser",
        "icon": "$(play)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.stopBrowser",
        "title": "Stop Browser",
        "icon": "$(debug-stop)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.setBrowserMode",
        "title": "Set Browser Mode",
        "icon": "$(window)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.openBrowserUrl",
        "title": "Open URL in This Browser",
        "icon": "$(link-external)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.copyBrowserCdp",
        "title": "Copy CDP URL",
        "icon": "$(copy)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.copyBrowserPort",
        "title": "Copy Port",
        "icon": "$(symbol-number)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.focusBrowserTab",
        "title": "Focus Tab",
        "icon": "$(browser)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.refreshBrowsers",
        "title": "Refresh Browsers",
        "icon": "$(refresh)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.addBrowserProfile",
        "title": "Add Browser Profile",
        "icon": "$(add)",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.removeBrowserProfile",
        "title": "Remove Browser Profile",
        "category": "PortPilot"
      }
    ],
    "configuration": {
      "title": "PortPilot",
      "properties": {
        "portpilot.webPortal.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run the PortPilot web portal (browser UI, loopback-only + token-gated) whenever this window is open. Opt-in; off by default."
        },
        "portpilot.webPortal.stopAppsOnStop": {
          "type": "boolean",
          "default": false,
          "description": "When the web portal stops, also stop the dev servers it started. Off by default, so dev servers keep running across portal restarts."
        },
        "portpilot.foldStoppedApps": {
          "type": "boolean",
          "default": true,
          "description": "Sort running and crashed apps first and fold stopped apps into a collapsed \"Stopped (N)\" node at the end of each list."
        },
        "portpilot.rowPreviews": {
          "type": "boolean",
          "default": true,
          "description": "Show page previews on running apps: hover a running app to see a thumbnail of its page. Thumbnails are read from PortPilot's local run history and never leave this machine."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "portpilot.addApp",
          "when": "view == portpilot.apps",
          "group": "navigation"
        },
        {
          "command": "portpilot.foldStopped",
          "when": "view == portpilot.apps && !portpilot.foldStopped",
          "group": "navigation@1"
        },
        {
          "command": "portpilot.unfoldStopped",
          "when": "view == portpilot.apps && portpilot.foldStopped",
          "group": "navigation@1"
        },
        {
          "command": "portpilot.refresh",
          "when": "view == portpilot.apps || view == portpilot.activePorts",
          "group": "navigation"
        },
        {
          "command": "portpilot.deleteAllApps",
          "when": "view == portpilot.apps",
          "group": "2_manage"
        },
        {
          "command": "portpilot.scanPorts",
          "when": "view == portpilot.activePorts",
          "group": "navigation"
        },
        {
          "command": "portpilot.searchHistory",
          "when": "view == portpilot.history",
          "group": "navigation@1"
        },
        {
          "command": "portpilot.refreshHistory",
          "when": "view == portpilot.history",
          "group": "navigation@2"
        },
        {
          "command": "portpilot.addBrowserProfile",
          "when": "view == portpilot.browsers",
          "group": "navigation@1"
        },
        {
          "command": "portpilot.refreshBrowsers",
          "when": "view == portpilot.browsers",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "portpilot.startApp",
          "when": "view == portpilot.apps && viewItem == app-stopped",
          "group": "inline@1"
        },
        {
          "command": "portpilot.stopApp",
          "when": "view == portpilot.apps && viewItem == app-running",
          "group": "inline@1"
        },
        {
          "command": "portpilot.openInBrowser",
          "when": "view == portpilot.apps && viewItem == app-running",
          "group": "inline@2"
        },
        {
          "command": "portpilot.toggleFavorite",
          "when": "view == portpilot.apps",
          "group": "inline@3"
        },
        {
          "command": "portpilot.editApp",
          "when": "view == portpilot.apps",
          "group": "1_edit@1"
        },
        {
          "command": "portpilot.changePort",
          "when": "view == portpilot.apps",
          "group": "1_edit@2"
        },
        {
          "command": "portpilot.openFolder",
          "when": "view == portpilot.apps",
          "group": "1_edit@3"
        },
        {
          "command": "portpilot.deleteApp",
          "when": "view == portpilot.apps",
          "group": "3_danger"
        },
        {
          "command": "portpilot.killPort",
          "when": "view == portpilot.activePorts && viewItem == active-port",
          "group": "inline"
        },
        {
          "command": "portpilot.openInBrowser",
          "when": "view == portpilot.activePorts && viewItem == active-port",
          "group": "inline"
        },
        {
          "command": "portpilot.openHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hlive/",
          "group": "inline@1"
        },
        {
          "command": "portpilot.startHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hstart/",
          "group": "inline@1"
        },
        {
          "command": "portpilot.copyHistoryUrl",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hurl/",
          "group": "inline@2"
        },
        {
          "command": "portpilot.pinHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hunpinned/",
          "group": "inline@3"
        },
        {
          "command": "portpilot.unpinHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hpinned/",
          "group": "inline@3"
        },
        {
          "command": "portpilot.openHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hlive/",
          "group": "1_open@1"
        },
        {
          "command": "portpilot.startHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hstart/",
          "group": "1_open@1"
        },
        {
          "command": "portpilot.copyHistoryUrl",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hurl/",
          "group": "1_open@2"
        },
        {
          "command": "portpilot.openHistoryFolder",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hfolder/",
          "group": "1_open@3"
        },
        {
          "command": "portpilot.pinHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hunpinned/",
          "group": "2_pin"
        },
        {
          "command": "portpilot.unpinHistoryRun",
          "when": "view == portpilot.history && viewItem =~ /hrun/ && viewItem =~ /hpinned/",
          "group": "2_pin"
        },
        {
          "command": "portpilot.startBrowser",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bdown/",
          "group": "inline@1"
        },
        {
          "command": "portpilot.stopBrowser",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bup/",
          "group": "inline@1"
        },
        {
          "command": "portpilot.openBrowserUrl",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bup/",
          "group": "inline@2"
        },
        {
          "command": "portpilot.startBrowser",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bdown|bheld/",
          "group": "1_run@1"
        },
        {
          "command": "portpilot.stopBrowser",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bup/",
          "group": "1_run@2"
        },
        {
          "command": "portpilot.setBrowserMode",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/",
          "group": "1_run@3"
        },
        {
          "command": "portpilot.openBrowserUrl",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bup/",
          "group": "2_open@1"
        },
        {
          "command": "portpilot.copyBrowserCdp",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/",
          "group": "3_copy@1"
        },
        {
          "command": "portpilot.copyBrowserPort",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/",
          "group": "3_copy@2"
        },
        {
          "command": "portpilot.removeBrowserProfile",
          "when": "view == portpilot.browsers && viewItem =~ /bprofile/ && viewItem =~ /bdown|bheld/",
          "group": "4_manage@1"
        }
      ],
      "commandPalette": [
        {
          "command": "portpilot.foldStopped",
          "when": "!portpilot.foldStopped"
        },
        {
          "command": "portpilot.unfoldStopped",
          "when": "portpilot.foldStopped"
        },
        {
          "command": "portpilot.openHistoryRun",
          "when": "false"
        },
        {
          "command": "portpilot.startHistoryRun",
          "when": "false"
        },
        {
          "command": "portpilot.copyHistoryUrl",
          "when": "false"
        },
        {
          "command": "portpilot.pinHistoryRun",
          "when": "false"
        },
        {
          "command": "portpilot.unpinHistoryRun",
          "when": "false"
        },
        {
          "command": "portpilot.openHistoryFolder",
          "when": "false"
        },
        {
          "command": "portpilot.startBrowser",
          "when": "false"
        },
        {
          "command": "portpilot.stopBrowser",
          "when": "false"
        },
        {
          "command": "portpilot.removeBrowserProfile",
          "when": "false"
        },
        {
          "command": "portpilot.setBrowserMode",
          "when": "false"
        },
        {
          "command": "portpilot.openBrowserUrl",
          "when": "false"
        },
        {
          "command": "portpilot.copyBrowserCdp",
          "when": "false"
        },
        {
          "command": "portpilot.copyBrowserPort",
          "when": "false"
        },
        {
          "command": "portpilot.focusBrowserTab",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "portpilot.history",
        "contents": "No localhost pages recorded yet. Start a dev server and it will appear here."
      },
      {
        "view": "portpilot.browsers",
        "contents": "No browser profiles yet. Each one is a named browser with its own debug port and sign-ins.\n[Add a profile](command:portpilot.addBrowserProfile)\nYour AI assistant can then ask for one by purpose with start_browser."
      }
    ]
  },
  "scripts": {
    "copy-runtime": "node scripts/copy-runtime.js",
    "vscode:prepublish": "npm run copy-runtime && tsc -p ./",
    "compile": "npm run copy-runtime && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run copy-runtime && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "claude",
    "claude code",
    "mcp",
    "ports",
    "dev server",
    "localhost",
    "worktree",
    "port manager",
    "process"
  ],
  "galleryBanner": {
    "color": "#1a1b26",
    "theme": "dark"
  },
  "homepage": "https://m4cd4r4.github.io/PortPilot/",
  "bugs": {
    "url": "https://github.com/m4cd4r4/PortPilot/issues"
  }
}
