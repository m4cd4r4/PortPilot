    {
      "name": "add_worktree",
      "description": "Register a git worktree or branch of a project so it appears nested under the main project in PortPilot and can run on its own port alongside it. Auto-detects the branch and the parent repo from git. Use this instead of add_app when registering a branch/worktree of an already-registered project - e.g. when working in a worktree that runs on a different port than the configured one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path to the worktree / branch working directory"
          },
          "command": {
            "type": "string",
            "description": "Start command; defaults to the parent app command or \"npm run dev\""
          },
          "preferredPort": {
            "type": "number",
            "description": "Preferred port for this branch - use a DIFFERENT port than the parent so both can run"
          },
          "branch": {
            "type": "string",
            "description": "Branch label shown on the row; auto-detected from git if omitted"
          },
          "parent": {
            "type": "string",
            "description": "Parent app id or name to nest under; auto-resolved from the repo's main worktree if omitted"
          },
          "name": {
            "type": "string",
            "description": "Display name; defaults to the parent name or the folder name"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
