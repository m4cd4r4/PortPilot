    {
      "name": "add_app",
      "description": "Register a new app in PortPilot",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "App display name"
          },
          "command": {
            "type": "string",
            "description": "Shell command to start (e.g. \"npm run dev\")"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory path"
          },
          "preferredPort": {
            "type": "number",
            "description": "Preferred port number"
          },
          "isFavorite": {
            "type": "boolean",
            "description": "Mark as favorite"
          },
          "autoStart": {
            "type": "boolean",
            "description": "Auto-start on launch"
          },
          "group": {
            "type": "string",
            "description": "Group name to assign to"
          },
          "description": {
            "type": "string",
            "description": "Short description"
          }
        },
        "required": [
          "name",
          "command",
          "cwd"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
